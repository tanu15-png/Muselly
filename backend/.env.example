SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Backend only. Secret key (sb_secret_...) for private Storage.
# Never put this key in frontend/.env or a VITE_ variable.
SUPABASE_SECRET_KEY=
# Legacy service_role JWT is also supported if SUPABASE_SECRET_KEY is unset.
SUPABASE_SERVICE_ROLE_KEY=
# Use the Direct or Session pooler connection from Supabase's Connect panel.
# Change the scheme to postgresql+psycopg and URL-encode the password.
DATABASE_URL=postgresql+psycopg://postgres.your-project:your-password@your-session-pooler-host:5432/postgres?sslmode=require
APP_ORIGIN=http://localhost:5173
# Backend only. Model access depends on your Gemini project's quota/billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Backend only. Use the API host provisioned for your Qloo account/key.
QLOO_API_KEY=
QLOO_BASE_URL=https://api.qloo.com
